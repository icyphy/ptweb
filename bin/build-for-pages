#!/usr/bin/env python3
"""Build a static copy of ptweb for GitHub Pages.

Copies the site tree into an output directory, expands Apache SSI
<!--#include virtual="..."> directives, and rewrites Berkeley hostnames
for the GitHub-hosted site only (source files in the repo are unchanged).

Usage:
    bin/build-for-pages [output_dir]

Default output_dir is _site at the repository root.

Environment:
    PTWEB_BASE_PATH  Optional URL prefix when the site is not served from the
                     domain root (e.g. /ptweb for icyphy.github.io/ptweb/).
                     Leave unset or empty when using a custom domain at root
                     (e.g. ptolemy.org).
"""

from __future__ import annotations

import os
import re
import shutil
import sys
from pathlib import Path

SSI_INCLUDE = re.compile(
    r"<!--#include\s+virtual=[\"']([^\"']+)[\"']\s*-->",
    re.IGNORECASE,
)

# href="/...", src="/...", action="/..." (not protocol-relative //...)
ROOT_ATTR = re.compile(
    r'(\b(?:href|src|action)\s*=\s*["\'])/',
    re.IGNORECASE,
)

# url(/...) in CSS
ROOT_CSS_URL = re.compile(r"url\(\s*/", re.IGNORECASE)

# <meta http-equiv="REFRESH" content="5;url=/...">
ROOT_META_URL = re.compile(r"(\burl=)/", re.IGNORECASE)

HTML_SUFFIXES = {".htm", ".html", ".shtml"}

# Applied only to built output, not to committed source.
URL_SUBSTITUTIONS = (
    ("ptolemy.berkeley.edu", "ptolemy.org"),
    ("ptolemy.eecs.berkeley.edu", "ptolemy.org"),
)

TEXT_SUFFIXES = HTML_SUFFIXES | {
    ".css",
    ".js",
    ".txt",
    ".xml",
    ".sum",
    ".faq",
    ".pl",
    ".htaccess",
}

SKIP_NAMES = {".git", "_site", ".github", "__pycache__"}

# Berkeley Apache aliases that are not present as literal directories.
VIRTUAL_PATH_ALIASES = {
    "adm": "admin",
}

# Short URL paths served by Apache Alias on Berkeley; map to repo directories.
URL_PATH_ALIASES = {
    "systems": "books/Systems",
}


def repo_root() -> Path:
    return Path(__file__).resolve().parent.parent


def normalize_virtual_path(virtual_path: str) -> Path:
    path = virtual_path.strip()
    if path.startswith("/"):
        path = path[1:]
    normalized = os.path.normpath(path)
    if normalized == ".":
        normalized = ""
    parts = Path(normalized).parts
    if parts and parts[0] in VIRTUAL_PATH_ALIASES:
        alias = VIRTUAL_PATH_ALIASES[parts[0]]
        normalized = str(Path(alias, *parts[1:]))
    return Path(normalized)


def is_remote_virtual_path(virtual_path: str) -> bool:
    lowered = virtual_path.strip().lower()
    return lowered.startswith("http://") or lowered.startswith("https://")


def substitute_urls(text: str) -> str:
    for old, new in URL_SUBSTITUTIONS:
        text = text.replace(old, new)
    return text


def apply_path_aliases(text: str) -> str:
    """Rewrite short URL paths (e.g. /systems) to their repo locations."""
    for alias, target in URL_PATH_ALIASES.items():
        text = re.sub(
            rf'(\b(?:href|src|action)\s*=\s*["\'])/{alias}(?=["\']|/)',
            rf"\1/{target}",
            text,
            flags=re.IGNORECASE,
        )
        text = re.sub(
            rf"(\burl=)/{alias}(?=['\"]|/)",
            rf"\1/{target}",
            text,
            flags=re.IGNORECASE,
        )
        text = re.sub(
            rf"(https?://ptolemy\.org)/{alias}(?=/|['\"]|>|<|\s|$)",
            rf"\1/{target}",
            text,
            flags=re.IGNORECASE,
        )
    return text


def transform_text(text: str, base_path: str) -> str:
    """Hostname, path-alias, and base-path rewrites for built output only."""
    text = substitute_urls(text)
    text = apply_path_aliases(text)
    text = apply_base_path(text, base_path)
    return text


def normalize_base_path(base_path: str) -> str:
    base_path = base_path.strip()
    if not base_path or base_path == "/":
        return ""
    if not base_path.startswith("/"):
        base_path = "/" + base_path
    return base_path.rstrip("/")


def apply_base_path(text: str, base_path: str) -> str:
    base = normalize_base_path(base_path)
    if not base:
        return text

    prefix = base + "/"
    skip = base.lstrip("/") + "/"

    def should_prefix(remainder: str) -> bool:
        if remainder.startswith("/"):
            return False
        if remainder.startswith(skip):
            return False
        return True

    def attr_repl(match: re.Match[str]) -> str:
        remainder = text[match.end() :]
        if not should_prefix(remainder):
            return match.group(0)
        return f"{match.group(1)}{prefix}"

    def css_repl(match: re.Match[str]) -> str:
        remainder = text[match.end() :]
        if not should_prefix(remainder):
            return match.group(0)
        return f"url({prefix}"

    def meta_repl(match: re.Match[str]) -> str:
        remainder = text[match.end() :]
        if not should_prefix(remainder):
            return match.group(0)
        return f"{match.group(1)}{prefix}"

    text = ROOT_ATTR.sub(attr_repl, text)
    text = ROOT_CSS_URL.sub(css_repl, text)
    text = ROOT_META_URL.sub(meta_repl, text)
    return text


def expand_ssi(content: str, site_root: Path, stack: tuple[str, ...]) -> str:
    def replace(match: re.Match[str]) -> str:
        virtual_path = match.group(1)
        if is_remote_virtual_path(virtual_path):
            return f"<!-- SSI remote include omitted: {virtual_path} -->"

        rel = normalize_virtual_path(virtual_path)
        include_path = (site_root / rel).resolve()
        site_resolved = site_root.resolve()

        try:
            include_path.relative_to(site_resolved)
        except ValueError as exc:
            raise ValueError(f"SSI include escapes site root: {virtual_path}") from exc

        key = str(include_path)
        if key in stack:
            raise ValueError(f"SSI circular include: {' -> '.join(stack + (key,))}")

        if not include_path.is_file():
            return f"<!-- SSI include missing: {virtual_path} -->"

        included = include_path.read_text(encoding="utf-8", errors="replace")
        expanded = expand_ssi(included, site_root, stack + (key,))
        return substitute_urls(expanded)

    expanded = SSI_INCLUDE.sub(replace, content)
    return expanded


def should_copy(name: str) -> bool:
    return name not in SKIP_NAMES


def copy_site(source: Path, destination: Path) -> None:
    if destination.exists():
        shutil.rmtree(destination)
    destination.mkdir(parents=True)

    for entry in source.iterdir():
        if not should_copy(entry.name):
            continue
        target = destination / entry.name
        if entry.is_dir():
            shutil.copytree(
                entry,
                target,
                ignore=lambda _dir, names: [n for n in names if not should_copy(n)],
                symlinks=True,
            )
        else:
            shutil.copy2(entry, target, follow_symlinks=False)


def create_path_alias_stubs(site_root: Path, base_path: str) -> int:
    """Add redirect stubs so bookmarked short URLs (e.g. /systems) still work."""
    prefix = normalize_base_path(base_path)
    url_prefix = f"{prefix}/" if prefix else "/"
    count = 0

    for alias, target in URL_PATH_ALIASES.items():
        alias_dir = site_root / alias
        if alias_dir.exists():
            continue

        target_url = f"{url_prefix}{target}/index.htm"
        alias_dir.mkdir(parents=True)
        (alias_dir / "index.htm").write_text(
            "<!DOCTYPE html>\n"
            f'<meta http-equiv="refresh" content="0;url={target_url}">\n'
            f'<p>Redirecting to <a href="{target_url}">{target}</a>.</p>\n',
            encoding="utf-8",
        )
        count += 1

    return count


def process_html_files(site_root: Path, base_path: str) -> int:
    count = 0
    for path in site_root.rglob("*"):
        if not path.is_file() or path.suffix.lower() not in HTML_SUFFIXES:
            continue
        content = path.read_text(encoding="utf-8", errors="replace")
        if "<!--#include" not in content.lower():
            continue
        expanded = expand_ssi(content, site_root, ())
        updated = transform_text(expanded, base_path)
        path.write_text(updated, encoding="utf-8")
        count += 1
    return count


def apply_url_substitutions(site_root: Path, base_path: str) -> int:
    count = 0
    for path in site_root.rglob("*"):
        if not path.is_file():
            continue
        if path.name == "robots.txt" or path.suffix.lower() in TEXT_SUFFIXES:
            original = path.read_text(encoding="utf-8", errors="replace")
            updated = transform_text(original, base_path)
            if updated != original:
                path.write_text(updated, encoding="utf-8")
                count += 1
    return count


def main() -> int:
    root = repo_root()
    output = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else root / "_site"

    if output == root:
        print("Refusing to build into the repository root.", file=sys.stderr)
        return 1

    base_path = os.environ.get("PTWEB_BASE_PATH", "")

    print(f"Copying site from {root} to {output}")
    copy_site(root, output)

    if base_path:
        print(f"Using base path prefix: {normalize_base_path(base_path)}")
    else:
        print("Using base path prefix: (none — site served from domain root)")

    print("Expanding SSI includes...")
    html_count = process_html_files(output, base_path)
    print(f"  expanded includes in {html_count} HTML files")

    print("Applying build-time URL substitutions...")
    text_count = apply_url_substitutions(output, base_path)
    print(f"  updated {text_count} text files")

    print("Creating path alias redirect stubs...")
    stub_count = create_path_alias_stubs(output, base_path)
    print(f"  created {stub_count} redirect stub(s)")

    print(f"Build complete: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
