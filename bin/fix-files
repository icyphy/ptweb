# ptwebfix - Fix common problems in web pages
# Usage: ptwebfix [-n|-d] files
#	-n don't actually do anything
#	-d turn on debugging




printonly=no

while getopts nd-- opt
do
	case $opt in
		d) 	set -x;;
		n) 	printonly=yes;;
	   \?)	echo "$0: Usage: $0 [-n] [-x] [filenames . . .]"
			echo " -n  Print only, do not actually do anything"
			echo " -d  debug"
			exit 3;;
	esac
done
shift `expr $OPTIND - 1`


SCCS=/usr/ccs/bin/sccs
files=$@

toptop=`pwd`
useegrep=yes
# Shell function that actually does the fixing
fixit() { 
    files=$files
    for fullfile in $files
    do
	cd $toptop
	echo "Now processing: $fullfile in `pwd`"
	if [ "$useegrep" = "yes" ]; then
	    egrep -s -e  "$EGREPMATCH" $fullfile
	else
	    searchit $fullfile
	fi    
	retval=$?
	if [ $retval = 0 ]; then
		# There was a difference, so we might want to check this sucker out
		file=`basename $fullfile`
		dirname=`dirname $fullfile`
		cd $dirname

		retval=0

		if [ "$printonly" = "no" ]; then
			if [ -d SCCS ]; then
			    $SCCS edit $file
			    retval=$?
			fi    
			#co -q -l $file

		else
			if [ -d SCCS ]; then
			   $SCCS info | awk '{print $1}' | grep "$file"
			    #rlog -R -L $file
			    retval=$?
			    if [ $retval = 1 ]; then
				echo "	Would be checked out. "
			    else
				echo "	Some sort of rlog problem. "
			    fi
			    doit
			else   
			    doit
			fi    
		fi
		if [ "$printonly" = "no" ]; then
			if [ $retval != 0 ]; then
				echo "	Could not check out $1. Skipping"
				continue
			else
				doit
				cp -f /tmp/fix-files.tmp  $file
				if [ -d SCCS ]; then
				    $SCCS delget -y"$LOGMESSAGE" $file
				else    
				    if [ -d CVS ]; then
					echo "skipping cvs commit"
					#cvs commit -m "$LOGMESSAGE" $file 
				    fi	
				fi
				#/users/ptdesign/adm/bin/sccsadmin $file
    				#grep Copyright $file
			fi
		fi	
	else
	   echo "	No difference, so no checkout"
	fi
    done
}

doit() {
	sed -e 's@"main.htm"@"index.htm"@g' \
	    -e 's@/main.htm"@/index.htm"@g' \
	    $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='"main.htm"|/main.htm"' 
LOGMESSAGE="link to index.htm, not main.htm" 


doit() {
	sed -e 's@\(<img [^>]*\)\(/*\)>@\1 hspace="25"/>@g' \
	    $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='<img .*>$'
LOGMESSAGE="Added hspace=25"


doit() {
       awk '{ if ($0 ~ /ssi\/top.htm/) {
                  print "<!--#include virtual=\"/ssi/toppremenu.htm\" -->"
                  print "<!--#include virtual=\"/publications/toc.htm\" -->"
                  print "<!--#include virtual=\"/ssi/toppostmenu.htm\" -->"
              } else {
                  print $0
              }
            }' $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='/ssi/top.htm'
LOGMESSAGE="Use pubs specific toc"

doit() {
	sed -e 's@ target="body"@@g' \
        -e 's@ target="main"@@g' \
        -e 's@ target="_top"@@g' \
        -e 's@code>g@code>@g' \
	    $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='target='
LOGMESSAGE="remove target="

doit() {
    awk '{
             if ( $0 ~ /<title>/ || $0 ~ /<TITLE>/) {
                 title = $0
             } 
             if ( $0 ~ /<\/body>/ || $0 ~ /<\/BODY/) {
                 printme = 0
                 print "<!--#include virtual=\"/eecs20/bottom.html\" -->" 
             }
             if (printme == 1) {
                 print $0
             }
             if ( $0 ~ /<body/ || $0 ~ /<body/) {
                 printme = 1
                 print "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">"
                 print "<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en-US\" lang=\"en-US\">"
                 print "<head>"
                 print "<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\" />"
                 print title
                 print "<!--#include virtual=\"top.html\" -->"
                 print "</head>"
                 print "<body>"
             }
        }' $file | \
        sed -e 's/PARAM NAME = /param name=/' \
            -e 's/APPLET/applet/' \
	    -e 's/TITLE>/title>/' \
	    -e 's/HTML>/html>/' \
	    -e 's/HEAD>/head>/' \
	    -e 's/BODY>/body>/' \
	    -e 's/H1>/h1>/g' \
	    -e 's/<P>/<p>/g' \
	    -e 's/CENTER>/center>/g' \
	    -e 's/VALUE = /value=/' \
	    > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='<link href="default.css"'
LOGMESSAGE="Use ssi"


fixit