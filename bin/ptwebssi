echo "###################################################"
echo ' 7) If there is an index.htm* file that contains a frameset, then process'

useegrep=no
#If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" = "index.html" -o "$basename" = "index.htm" ]; then
        dirname=`dirname $1`
	if [ ! -f "$dirname/main.htm" ]; then
	    echo "$1: $dirname/main.htm not present, so not copying main.htm into index.htm"
	    return 1
        fi
        EGREPMATCH='<meta http-equiv="REFRESH"'
	egrep -s -e  "$EGREPMATCH" $dirname/main.htm
	retval=$?
	if [ $retval = 0 ]; then
	    echo "$1: main.htm had REFRESH, so $file is done?"
	    return 1
        fi
        EGREPMATCH='^<frameset'
	egrep -s -e  "$EGREPMATCH" $1
	retval=$?
        return $retval
    else
        # Not an index.htm file, return 1
        return 1
    fi
}

doit() {
    dirname=`dirname $file`
    if [ ! -f "$dirname/main.htm" ]; then
	echo "$file: $dirname/main.htm does not exist, so do nothing"
        cp $file /tmp/fix-files.tmp
	return
    fi	
    title=`egrep -i "[ 	]*<title>" $dirname/main.htm`    
    cat <<EoF >/tmp/fix-files.tmp 
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<!-- \$Id$ -->
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en-US" lang="en-US">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1" />

$title

<!--#include virtual="/projects/icyphywww/ssi/top.htm"-->
EoF
        awk '{ if (sawbody==1) {
	           if ($1 ~ /<\/body>/ || $1 ~ /<\/BODY>/ ) {
		       print "<!-- #include virtual=\"/projects/icyphywww/ssi/bottom.htm\" -->"
		       exit
                   } else {
                       print $0
                   }  
               } else { 
	           if ($1 == "<body>") {
                       sawbody = 1 
                   } 
               }
            }' $dirname/main.htm \
	   >> /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='href="http://[^"]*">'
LOGMESSAGE="Convert index.htm to use SSI"

fixit
useegrep=yes

echo "###################################################"
echo ' 8) If there is a main.htm or body.htm that does not redirect, then do so.'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    # If the file is not named main.htm or body.ht, return 1
    if [ "$basename" != "main.htm" -a "$basename" != "body.htm" ]; then
        return 1
    fi

    # If the file has the string the return 1
    awk '$0 ~ /<meta http-equiv="REFRESH"/ { exit 1}' $1
}
doit() {
    dirname=`dirname $fullfile |  sed 's@^\./@/@'`
    
    # FIXME: this only works if we are in the ptweb directory
    curdirbase=`basename $toptop`
    if [ "$curdirbase" != "ptweb" ]; then
       echo "$file: must run in ptweb dir to fix up main.htm and body.htm"
       cp $file /tmp/fix-files.tmp
       return
    fi
    url="$dirname/$file"
    targeturl="$dirname/index.htm"
    title=`egrep -i "^<title>" $file`
    h1=`egrep -i "^<h1>" $file` 
    cat << EoF2 >/tmp/fix-files.tmp 
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en-US" lang="en-US">
<head>
$title
<meta http-equiv="REFRESH" content="5;url=/$targeturl"></HEAD>
<!--#include virtual="/projects/icyphywww/ssi/top.htm"-->
$h1
The page 
<code>http://ptolemy.eecs.berkeley.edu/$url</code>
has moved to <a href="http://ptolemy.eecs.berkeley.edu/$targeturl"><code>http://ptolemy.eecs.berkeley.edu/$targeturl</code></a>.
<p>You will be redirected to the new page in 5 seconds, or you may
click on the above link.
<!--#include virtual="/projects/icyphywww/ssi/bottom.htm" -->
EoF2
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='href="http://[^"]*">'
LOGMESSAGE="Use redirect"

fixit
useegrep=yes

echo "###################################################"
echo ' 9) process .htm files that do not redirect or yet use SSI'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    # If the file is named toc.htm, then skip it
    if [ "$basename" = "toc.htm" ]; then
        return 1
    fi

    awk '$0 ~ /#include virtual="/ { exit 1}
         $0 ~ /<meta http-equiv="REFRESH"/ { exit 1}
        ' $1
}
doit() {
    title=`egrep -i "[ 	]*<title>" $file`
    cat <<EoF >/tmp/fix-files.tmp 
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<!-- \$Id$ -->
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en-US" lang="en-US">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1" />

$title

<!--#include virtual="/projects/icyphywww/ssi/top.htm"-->
EoF
        awk '{ if (sawbody==1) {
	           if ($1 ~ /<\/body>/ || $1 ~ /<\/BODY>/ ) {
		       print "<!--#include virtual=\"/projects/icyphywww/ssi/bottom.htm\" -->"
		       exit
                   } else {
                       print $0
                   }  
               } else { 
	           if ($1 == "<body>") {
                       sawbody = 1 
                   } 
               }
            }' $file \
	   >> /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Use SSI"

fixit
useegrep=yes



echo "###################################################"
echo " 10) links that go to body.htm and _body should go to index.htm"
doit() {
	sed 's@\(href="http://[^"]*\)body.htm" target="_body>@\1index.htm">@' \
	    $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='target="_body"'
LOGMESSAGE="Instead of linking to body.htm and target=_body, link to index.htm"

fixit

echo "###################################################"
echo ' 11) If there is a toc.htm, then include it'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" = "toc.htm" ]; then
        echo "$1: Don't include toc.htm in itself"
        return 1
    fi
    dirname=`dirname $1`
    if [ ! -f "$dirname/toc.htm" ]; then
        echo "$1: $dirname/toc.htm not present, so not including.htm into $1"
        return 1
    fi
    EGREPMATCH='<!--#include virtual="/projects/icyphywww/ssi/top.htm"-->'
    egrep -s -e  "$EGREPMATCH" $1
    retval=$?
    return $retval
}
doit() {
    # FIXME: this only works if we are in the ptweb directory
    curdirbase=`basename $toptop`
    if [ "$curdirbase" != "ptweb" ]; then
       echo "$file: must run in ptweb dir to fix up $file to include toc.htm"
       cp $file /tmp/fix-files.tmp
       return
    fi
    dirname=`dirname $fullfile |  sed 's@^\./@/@'`
    gawk -v dirname="$dirname" '{ if ($0 ~ /<!--#include virtual="\/ssi\/top.htm"-->/) {
               print "<!--#include virtual=\"/projects/icyphywww/ssi/toppremenu.htm\" -->"
               print "<!--#include virtual=\"/projects/icyphywww/" dirname "/toc.htm\" -->"
               print "<!--#include virtual=\"/projects/icyphywww/ssi/toppostmenu.htm\" -->"
         } else {
               print $0
         }
      }' $file \
	   > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Use local toc"

fixit
useegrep=yes

echo "###################################################"
echo ' 12) Fix up toc.htm'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" != "toc.htm" ]; then
        echo "$1: Only operate on toc.htm"
        return 1
    fi
    awk '$0 ~ /<div id="menu">/ { exit 1}' $1
}
doit() {
    awk 'BEGIN { print "<div id=\"menu\">"
                 print "<ul>"
         }
         $0 ~ /<a href=.*<\/[aA]>/ {
                 printf("<li>");
                 if ($0 ~ /<\/li>/) {
                     print $0
                 } else {
                     print $0 "</li>"
                 } 
         }
         END { print "</ul>"
               print "</div><!-- /#menu -->"
         }' $file |
    sed -e 's@<br>@@' \
        -e 's@<li class="first"><li class="first">@<li>@' \
        -e 's@<li class="first"><li>@<li>@' \
        -e 's@<li><li class="first">@<li>@' \
        -e 's@<li><li>@<li>@' \
        -e 's@<li> *<a@<li><a@' \
        -e 's@<p>@@' \
        -e 's@body.htm" target="body"@index.htm"@' \
        -e 's@main.htm" target="main"@index.htm"@' \
        -e 's@ target="body"@@' \
        -e 's@ target="main"@@' \
        -e 's@ target="_top"@@' \
        -e 's@body.htm"@index.htm"@' \
        -e 's@main.htm"@main.htm"@' \
	   > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Fix up toc"

fixit
useegrep=yes


echo "###################################################"
echo ' 13) Insert link to home in toc.htm'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" != "toc.htm" ]; then
        echo "$1: Only operate on toc.htm"
        return 1
    fi
    awk '$0 ~ /<a href="\/index.htm">Home<\/a>/ { exit 1}
         $0 ~ /<a href="*\/index.htm">Ptolemy Home<\/a>/ { exit 1}
         $0 ~ /<a href=".*\/index.htm">Ptolemy Home<\/a>/ { exit 1}' $1
}
doit() {
    gawk '{ 
           print $0
           if ($0 ~ /<ul>/) {
               print "<li><a href=\"/index.htm\">Home</a></li>"
           }
         }' $file |
    sed -e 's@<br>@@' \
        -e 's@<li class="first">@<li>@' \
        -e 's@<li><li>@<li>@' \
        -e 's@<li> *<a@<li><a@' \
        -e 's@<p>@@' \
        -e 's@body.htm" target="body"@index.htm"@' \
        -e 's@main.htm" target="main"@index.htm"@' \
        -e 's@ target="body"@@' \
        -e 's@ target="main"@@' \
        -e 's@ target="_top"@@' \
        -e 's@body.htm"@index.htm"@' \
        -e 's@main.htm"@main.htm"@' \
	   > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Fix up toc"

fixit
useegrep=yes



echo "###################################################"
echo ' 14) Insert the title toc.htm'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" != "toc.htm" ]; then
        echo "$1: Only operate on toc.htm"
        return 1
    fi
    awk '$0 ~ /<h2>/ { exit 1}
         $0 ~ /<h3>/ { exit 1}' $1
}
doit() {
    h2=""
    EGREPMATCH='<h2>|<h3>'
    egrep -s -e  "$EGREPMATCH" $file
    retval=$? 
    if [ $retval = 1 ]; then
        # Get the title from the index and put it in toc.htm
        dirname=`dirname $file`
        h2=`egrep -i "^<title>" $dirname/main.htm |  sed -e 's@<title>@<h2>@' -e 's@</title>@</h2>@'`
    fi    

    gawk -v h2="$h2" '{ 
           print $0
           if ($0 ~ /<a href="\/index.htm">Home<\/a>/) {
               if ( h2 != "") {
                   print h2
               }
           }
         }' $file |
    sed -e 's@<br>@@' \
        -e 's@<li class="first">@<li>@' \
        -e 's@<li><li>@<li>@' \
        -e 's@<li> *<a@<li><a@' \
        -e 's@<p>@@' \
        -e 's@body.htm" target="body"@index.htm"@' \
        -e 's@main.htm" target="main"@index.htm"@' \
        -e 's@ target="body"@@' \
        -e 's@ target="main"@@' \
        -e 's@ target="_top"@@' \
        -e 's@body.htm"@index.htm"@' \
        -e 's@main.htm"@main.htm"@' \
	   > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Fix up toc"

fixit
useegrep=yes


echo "###################################################"
echo ' 15) remove arrows from gif'

useegrep=no
# If the file has the string the return 1
searchit() { 
    basename=`basename $1`
    if [ "$basename" != "toc.htm" ]; then
        echo "$1: Only operate on toc.htm"
        return 1
    fi
    egrep -s -e "leftarrow.gif|uparrow.gif" $1
}
doit() {
    grep -v "leftarrow.gif" $file |
       grep -v "uparrow.gif" > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH=''
LOGMESSAGE="Remove arrows from to"

fixit
useegrep=yes

