echo "###################################################"
echo ' 4) Convert @(#) to $Id$ '

doit() {
    sed 's/<!-- @(#).*>/<!-- \$Id\$ -->/' \
	    $file > /tmp/fix-files.tmp
	diff -c $file /tmp/fix-files.tmp
}
EGREPMATCH='<!-- @\(#\).*>'
LOGMESSAGE="Converted @(#) into $Id"
fixit

