# Script to sanity check java files

# ptwebchk - a script to catch common problems with html files for the
#	     ptolemy website

# 1) Check that the Content-type is set
# 1.1) Check that default.css, toc.css, or frameset is used
# 2) Check that all commas have spaces
# 3) Check for FIXME
# 4) Check for %W% %G% %Q%, which are from SCCS
# 5) Check for $Id CVS keyword#
# 6) bgcolor="#faf0e6" should be removed
# 7) links that go to pages outside our page should target _top
# 8) </LI> should not be present

doesnot () {
	egrep -s "$1" $file
	retval=$?
    	if [ $retval != 0 ]; then
	  echo "$file does not contain '$1' $2"
	fi
}
for file in $@
do
	# 1) Check that the Content-type is set
	doesnot '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=iso-8859-1">|frameset'  " "

	# 1.1) Check that default.css, toc.css or framesetis used
	doesnot 'lib/default.css" rel="stylesheet" type="text/css">|lib/toc.css" rel="stylesheet" type="text/css">|frameset'

	# 2) Check that all commas have spaces
	# A line that contains ", is ok
	# A line that contains ,</i> is ok
	# A line that contains frameset is ok
	# A line that contains ,000 is ok
	results=`egrep '[^"],[^v" ]' $file | grep -v ',[</i>]' | grep -v frameset | grep -v ,000`
	if [ "x$results" != "x" ]; then
	    echo "$file: comma without out trailing space:"
	    echo "$results"
	fi

	# 3) Check for FIXME
	results=`egrep 'FIXME' $file`
	if [ "x$results" != "x" ]; then
	    echo "$file: contains a FIXME"
	    echo "$results"
	fi

        # 4) Check for %W% %G% %Q%, which are from SCCS
	results=`egrep '%W%|%G%|%Q%' $file`
	if [ "x$results" != "x" ]; then
	    echo "$file: has old SCCS keywords: %W% or %G%"
	    echo "$results"
	fi

        # 5) Check for $Id CVS keyword
	doesnot '\$Id' "To fix this, add <!-- \$Id$ --> to the top"

	# 6) bgcolor="#faf0e6" should be removed
	results=`egrep -i '<body bgcolor="#faf0e6">' $file`
	if [ "x$results" != "x" ]; then
	    echo "$file: has <body bgcolor=...>, which should be replaced with <body>"
	    echo "$results"
	fi

	# 7) links that go to pages outside our page should have target="_top"
	results=`egrep -i '"http:' $file | grep -vi 'target=' | egrep -vi 'http://ptolemy.eecs.berkeley.edu/[^~]`
	if [ "x$results" != "x" ]; then
	    echo "$file: has a link to an outside website, but it is not have target=\"_top\""
	    echo "$results"
	fi

	# 8) </LI> should not be present
	results=`egrep -i '</LI>' $file`
	if [ "x$results" != "x" ]; then
	    echo "$file: has </LI>, which should not be present"
	    echo "$results"
	fi

done

