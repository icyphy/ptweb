#!/bin/bash

if [ $# -ne 1 ]; then
   echo "$0: Usage: $0 directoryName"
   exit 2
fi

directory=$1

if [ ! -d $directory ]; then
   echo "$0: $directory does not exist or is not a directory?"
fi

files=`find $directory -type f | egrep -v '(avi|dll|pdf|png|pot|ppt|pps|pptx|mp4|doc|docx|jpg|gif|tar|tar.gz|tgz|wav|WAV|xls|zip)$' | grep -v ' ' | xargs egrep '(|background="/|calendar|FAQ|href="/|input|Login|src="/|pubs/search/|virtual|wiki)' | awk -F: '{print $1}' | sort | uniq`

#files=`find $directory -type f | xargs egrep 'Quick search by ...' | awk -F: '{print $1}' | sort | uniq`

#files=`find $directory -type f | xargs egrep 'FAQ sections' | awk -F: '{print $1}' | sort | uniq`

#files=`find . -type f | xargs egrep 'referer=%2Fpubs%2F' | awk -F: '{print $1}' | sort | uniq`

echo "Found `echo $files | wc -w` files that may need fixing"

tmp=/tmp/fixweb.$$

for file in $files
do
	echo $file

	    # -e 's@pubs/search/?groupname=\([^&]*\)&amp;Action=Search@pubs/search/\1.html@' \
	    # -e 's@<li><a href="/[^"]*/calendar">Calendar</a> </li>@@' \

	    # -e 's@<input type="hidden" name="cx" value="[^"]*" />@<input type="hidden" name="cx" value="007295758319438328285:skvr4laywa4" />@' \
	    # -e 's@<li><a href="[^"]*">FAQ</a></li>@@' \
	    # -e "s@/projects/$directory/projects/$directory@/projects/$directory@g" \
	    # -e 's@/projects/terraswarm/login/?denied=1&amp;referer=%2Fpubs%2F\([0-9]*\).html@https://wiki.eecs.berkeley.edu/terraswarm-urbanheartbeat/Main/Publications#Publication_\1@' \

	# grep -ve '  <h2 class="sectionhead">Quick search by ...</h2>    <h3 class="sectionhead">Year</h3>' \
	#    -ve '<li><a href="/projects/$directory/pubs/search/.*</li>' \
	#    -ve '<h3 class="sectionhead">Group</h3>' \

	#grep -ve '<h2 class="sectionhead">FAQ sections</h2>' \
        #     -ve '<li><a href="/projects/cps-forces/forces/faq.*</li>' \
	#    $file > $tmp

	# -e 's@pubs/search/?year=\([0-9]*\)&amp;Action=Search@pubs/search/\1.html@' \
	# sed 's@href="http[s]*://robotics.eecs.berkeley.edu@href="/projects/robotics@g' \
	#	$file > $tmp

	# -e 's@virtual="/@virtual="/projects/human-cps/@g' \

   	sed \
	    -e "s@href=\"/@href=\"/projects/$directory/@g" \
	  -e "s@src=\"/@<a src=\"/projects/$directory/@g" \
          -e "s@background=\"/@background=\"/projects/$directory/@g" \
	  -e "s@<option value=\"/@<option value=\"/projects/$directory/@g" \
	  -e 's@<li class="first"><a href="/[^"]*login/">Login</a></li>@@' \
	  -e 's@<a href="/[^"]*/login/">Login</a>@@' \
	  -e 's@<li><a href="/[^"]*/calendar">Calendar</a> </li>@@' \
	  -e 's@<li><a href="[^"]*">FAQ</a></li>@@' \
	  -e 's@<h2 class="sectionhead">Quick search by ...</h2>    <h3 class="sectionhead">Year</h3>@@' \
	  -e 's@<li><a href="/projects/$directory/pubs/search/.*</li>@@' \
	  -e 's@<h3 class="sectionhead">Group</h3>@@' \
	  -e 's@<h2 class="sectionhead">FAQ sections</h2>@@' \
          -e 's@<li><a href=".*/faq.*</li>@@' \
	  -e 's@<li> <a href="/.*/search/">Search</a>@@' \
	  -e 's@<li> <a href="/.*/listinfo/">Mailing lists</a>@@' \
	  -e 's@<font size="-1"><i>You are not <a href="/login">logged in</a></i>&nbsp;</font>@@' \
	  -e "s@src=\"https://.*.eecs.berkeley.edu:443/@src=\"/projects/$directory/@g" \
	   $file > $tmp

	diff $file $tmp
	cp $tmp $file
done