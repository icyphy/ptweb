<?xml version="1.0" encoding="UTF-8"?>
<!-- JNLP is the Java Network Launching Protocol
     This file is derived from a *jnlp.in file by running
     sed on the *.jnlp.in file and substituting 
     /home/hudson/jobs/ptII/workspace/doc/books/systems/modelingtime
-->
<!-- href is needed so that web start can cache the app and
     it will appear in the desktop icon
-->
<jnlp codebase="http://ptolemy.eecs.berkeley.edu/books/Systems/models"
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/modelingtime/GeneratorResourceScheduler.jnlp"> 
<!-- jnlp
      codebase="file:./../../../.." 
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/modelingtime/GeneratorResourceScheduler.jnlp"-->
  <information>
	  <title>GeneratorResourceScheduler</title>
	  <vendor>Ptolemy Project, UC Berkeley</vendor>
	  <description kind="tooltip">GeneratorResourceScheduler</description>
	  <icon href="doc/img/PtolemyIISmall.gif"/>
	  <homepage href="/home/hudson/jobs/ptII/workspace/doc/books/systems/modelingtime"/>
	  <offline-allowed/>
  </information>
  <security> 
        <all-permissions/>
  </security> 

  <resources>
        <!-- Bump maximum heap size to 500Mb, use JVM Props. to confirm -->
  	<j2se version="1.6+" max-heap-size="500m" />
	<!-- Start Jars -->
        <jar href="doc/books/systems/modelingtime/signed_GeneratorResourceScheduler.jar"
             size="0"
             main="true"/>
        <jar href="signed/ptolemy/vergil/vergil.jar"
             size="895491"
             download="eager"/>
        <jar href="signed/ptolemy/ptsupport.jar"
             size="4067423"
             download="eager"/>
        <jar href="signed/ptolemy/domains/sr/sr.jar"
             size="46488"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/vergilApplet.jar"
             size="953961"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/basic/export/web/web.jar"
             size="55315"
             download="eager"/>
        <jar href="signed/ptolemy/domains/continuous/continuous.jar"
             size="161019"
             download="eager"/>
        <jar href="signed/ptolemy/domains/modal/modal.jar"
             size="200631"
             download="eager"/>
        <jar href="signed/ptolemy/domains/de/de.jar"
             size="101413"
             download="eager"/>
        <jar href="signed/ptolemy/domains/sdf/sdf.jar"
             size="152034"
             download="eager"/>
        <jar href="signed/ptolemy/actor/lib/aspect/aspect.jar"
             size="108262"
             download="eager"/>
        <jar href="signed/lib/diva.jar"
             size="538662"
             download="eager"/>

	<!-- End Jars -->
  </resources>
  <application-desc main-class="ptolemy.copernicus.applet.JNLPApplication">
	<argument>-ptinyViewer</argument>
	<argument>GeneratorResourceScheduler.xml</argument>
  </application-desc>
  <!-- applet-desc 
         name="GeneratorResourceScheduler Applet"
         main-class="ptolemy.vergil.VergilApplet"
         width="700"
         height="1120">
   </applet-desc-->


</jnlp>
