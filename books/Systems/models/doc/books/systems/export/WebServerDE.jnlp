<?xml version="1.0" encoding="UTF-8"?>
<!-- JNLP is the Java Network Launching Protocol
     This file is derived from a *jnlp.in file by running
     sed on the *.jnlp.in file and substituting 
     /home/hudson/jobs/ptII/workspace/doc/books/systems/export
-->
<!-- href is needed so that web start can cache the app and
     it will appear in the desktop icon
-->
<jnlp codebase="http://ptolemy.eecs.berkeley.edu/books/Systems/models"
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/export/WebServerDE.jnlp"> 
<!-- jnlp
      codebase="file:./../../../.." 
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/export/WebServerDE.jnlp"-->
  <information>
	  <title>WebServerDE</title>
	  <vendor>Ptolemy Project, UC Berkeley</vendor>
	  <description kind="tooltip">WebServerDE</description>
	  <icon href="doc/img/PtolemyIISmall.gif"/>
	  <homepage href="/home/hudson/jobs/ptII/workspace/doc/books/systems/export"/>
	  <offline-allowed/>
  </information>
  <security> 
        <all-permissions/>
  </security> 

  <resources>
        <!-- Bump maximum heap size to 500Mb, use JVM Props. to confirm -->
  	<j2se version="1.6+" max-heap-size="500m" />
	<!-- Start Jars -->
        <jar href="doc/books/systems/export/signed_WebServerDE.jar"
             size="0"
             main="true"/>
        <jar href="signed/ptolemy/actor/lib/python/python.jar"
             size="22529"
             download="eager"/>
        <jar href="signed/lib/javax.servlet-api-3.0.1.jar"
             size="98184"
             download="eager"/>
        <jar href="signed/lib/jython.jar"
             size="10976525"
             download="eager"/>
        <jar href="signed/ptolemy/domains/de/de.jar"
             size="101413"
             download="eager"/>
        <jar href="signed/ptolemy/ptsupport.jar"
             size="4063931"
             download="eager"/>
        <jar href="signed/lib/jetty-all-8.1.5-v20120716.jar"
             size="2090099"
             download="eager"/>
        <jar href="signed/lib/smack.jar"
             size="334903"
             download="eager"/>
        <jar href="signed/lib/smackx.jar"
             size="723083"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/vergilApplet.jar"
             size="954019"
             download="eager"/>
        <jar href="signed/org/ptolemy/ptango/ptango.jar"
             size="71507"
             download="eager"/>
        <jar href="signed/lib/diva.jar"
             size="538662"
             download="eager"/>
        <jar href="signed/ptolemy/domains/modal/modal.jar"
             size="200631"
             download="eager"/>

	<!-- End Jars -->
  </resources>
  <application-desc main-class="ptolemy.copernicus.applet.JNLPApplication">
	<argument>-ptinyViewer</argument>
	<argument>WebServerDE.xml</argument>
  </application-desc>
  <!-- applet-desc 
         name="WebServerDE Applet"
         main-class="ptolemy.vergil.VergilApplet"
         width="597"
         height="1302">
   </applet-desc-->


</jnlp>
