<?xml version="1.0" encoding="UTF-8"?>
<!-- JNLP is the Java Network Launching Protocol
     This file is derived from a *jnlp.in file by running
     sed on the *.jnlp.in file and substituting 
     /home/hudson/jobs/ptII/workspace/doc/books/systems/ptera
-->
<!-- href is needed so that web start can cache the app and
     it will appear in the desktop icon
-->
<jnlp codebase="http://ptolemy.eecs.berkeley.edu/books/Systems/models"
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/ptera/CarWashDE_Ptera_FSM.jnlp"> 
<!-- jnlp
      codebase="file:./../../../.." 
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/ptera/CarWashDE_Ptera_FSM.jnlp"-->
  <information>
	  <title>CarWashDE_Ptera_FSM</title>
	  <vendor>Ptolemy Project, UC Berkeley</vendor>
	  <description kind="tooltip">CarWashDE_Ptera_FSM</description>
	  <icon href="doc/img/PtolemyIISmall.gif"/>
	  <homepage href="/home/hudson/jobs/ptII/workspace/doc/books/systems/ptera"/>
	  <offline-allowed/>
  </information>
  <security> 
        <all-permissions/>
  </security> 

  <resources>
        <!-- Bump maximum heap size to 500Mb, use JVM Props. to confirm -->
  	<j2se version="1.6+" max-heap-size="500m" />
	<!-- Start Jars -->
        <jar href="doc/books/systems/ptera/signed_CarWashDE_Ptera_FSM.jar"
             size="0"
             main="true"/>
        <jar href="signed/ptolemy/vergil/vergil.jar"
             size="895551"
             download="eager"/>
        <jar href="signed/com/jgoodies/jgoodies.jar"
             size="100254"
             download="eager"/>
        <jar href="signed/lib/PDFRenderer.jar"
             size="2143504"
             download="eager"/>
        <jar href="signed/ptolemy/actor/gui/run/run.jar"
             size="75961"
             download="eager"/>
        <jar href="signed/ptolemy/domains/ptera/ptera.jar"
             size="129578"
             download="eager"/>
        <jar href="signed/org/mlc/mlc.jar"
             size="149746"
             download="eager"/>
        <jar href="signed/ptolemy/ptsupport.jar"
             size="4063931"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/vergilApplet.jar"
             size="954019"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/gt/gt.jar"
             size="204331"
             download="eager"/>
        <jar href="signed/ptolemy/actor/gt/gt.jar"
             size="373091"
             download="eager"/>
        <jar href="signed/lib/bsh-2.0b4.jar"
             size="309011"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/ptera/ptera.jar"
             size="29599"
             download="eager"/>
        <jar href="signed/ptolemy/domains/modal/modal.jar"
             size="200631"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/pdfrenderer/pdfrenderer.jar"
             size="26816"
             download="eager"/>
        <jar href="signed/ptolemy/domains/de/de.jar"
             size="101413"
             download="eager"/>
        <jar href="signed/lib/diva.jar"
             size="538662"
             download="eager"/>

	<!-- End Jars -->
  </resources>
  <application-desc main-class="ptolemy.copernicus.applet.JNLPApplication">
	<argument>-fullViewer</argument>
	<argument>CarWashDE_Ptera_FSM.xml</argument>
  </application-desc>
