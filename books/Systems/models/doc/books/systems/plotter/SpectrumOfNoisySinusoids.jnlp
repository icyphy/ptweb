<?xml version="1.0" encoding="UTF-8"?>
<!-- JNLP is the Java Network Launching Protocol
     This file is derived from a *jnlp.in file by running
     sed on the *.jnlp.in file and substituting 
     /home/hudson/jobs/ptII/workspace/doc/books/systems/plotter
-->
<!-- href is needed so that web start can cache the app and
     it will appear in the desktop icon
-->
<jnlp codebase="http://ptolemy.eecs.berkeley.edu/books/Systems/models"
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/plotter/SpectrumOfNoisySinusoids.jnlp"> 
<!-- jnlp
      codebase="file:./../../../.." 
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/plotter/SpectrumOfNoisySinusoids.jnlp"-->
  <information>
	  <title>SpectrumOfNoisySinusoids</title>
	  <vendor>Ptolemy Project, UC Berkeley</vendor>
	  <description kind="tooltip">SpectrumOfNoisySinusoids</description>
	  <icon href="doc/img/PtolemyIISmall.gif"/>
	  <homepage href="/home/hudson/jobs/ptII/workspace/doc/books/systems/plotter"/>
	  <offline-allowed/>
  </information>
  <security> 
        <all-permissions/>
  </security> 

  <resources>
        <!-- Bump maximum heap size to 500Mb, use JVM Props. to confirm -->
  	<j2se version="1.6+" max-heap-size="500m" />
	<!-- Start Jars -->
        <jar href="doc/books/systems/plotter/signed_SpectrumOfNoisySinusoids.jar"
             size="0"
             main="true"/>
        <jar href="signed/ptolemy/vergil/vergil.jar"
             size="895324"
             download="eager"/>
        <jar href="signed/ptolemy/ptsupport.jar"
             size="4153956"
             download="eager"/>
        <jar href="signed/ptolemy/domains/sdf/sdf.jar"
             size="152034"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/vergilApplet.jar"
             size="953792"
             download="eager"/>
        <jar href="signed/lib/diva.jar"
             size="538662"
             download="eager"/>
        <jar href="signed/ptolemy/domains/modal/modal.jar"
             size="200631"
             download="eager"/>

	<!-- End Jars -->
  </resources>
  <application-desc main-class="ptolemy.copernicus.applet.JNLPApplication">
	<argument>-ptinyViewer</argument>
	<argument>SpectrumOfNoisySinusoids.xml</argument>
  </application-desc>
  <!-- applet-desc 
         name="SpectrumOfNoisySinusoids Applet"
         main-class="ptolemy.vergil.VergilApplet"
         width="600"
         height="850">
   </applet-desc-->


</jnlp>
