<?xml version="1.0" encoding="UTF-8"?>
<!-- JNLP is the Java Network Launching Protocol
     This file is derived from a *jnlp.in file by running
     sed on the *.jnlp.in file and substituting 
     /home/hudson/jobs/ptII/workspace/doc/books/systems/continuous
-->
<!-- href is needed so that web start can cache the app and
     it will appear in the desktop icon
-->
<jnlp codebase="http://ptolemy.eecs.berkeley.edu/books/Systems/models"
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/continuous/ContinuousInsideDE.jnlp"> 
<!-- jnlp
      codebase="file:./../../../.." 
      href="http://ptolemy.eecs.berkeley.edu/books/Systems/models/doc/books/systems/continuous/ContinuousInsideDE.jnlp"-->
  <information>
	  <title>ContinuousInsideDE</title>
	  <vendor>Ptolemy Project, UC Berkeley</vendor>
	  <description kind="tooltip">ContinuousInsideDE</description>
	  <icon href="doc/img/PtolemyIISmall.gif"/>
	  <homepage href="/home/hudson/jobs/ptII/workspace/doc/books/systems/continuous"/>
	  <offline-allowed/>
  </information>
  <security> 
        <all-permissions/>
  </security> 

  <resources>
        <!-- Bump maximum heap size to 500Mb, use JVM Props. to confirm -->
  	<j2se version="1.6+" max-heap-size="500m" />
	<!-- Start Jars -->
        <jar href="doc/books/systems/continuous/signed_ContinuousInsideDE.jar"
             size="0"
             main="true"/>
        <jar href="signed/ptolemy/domains/continuous/continuous.jar"
             size="161019"
             download="eager"/>
        <jar href="signed/ptolemy/actor/lib/colt/colt.jar"
             size="51109"
             download="eager"/>
        <jar href="signed/lib/ptcolt.jar"
             size="62063"
             download="eager"/>
        <jar href="signed/ptolemy/ptsupport.jar"
             size="4063931"
             download="eager"/>
        <jar href="signed/ptolemy/domains/de/de.jar"
             size="101413"
             download="eager"/>
        <jar href="signed/ptolemy/vergil/vergilApplet.jar"
             size="954019"
             download="eager"/>
        <jar href="signed/lib/diva.jar"
             size="538662"
             download="eager"/>
        <jar href="signed/ptolemy/domains/modal/modal.jar"
             size="200631"
             download="eager"/>

	<!-- End Jars -->
  </resources>
  <application-desc main-class="ptolemy.copernicus.applet.JNLPApplication">
	<argument>-ptinyViewer</argument>
	<argument>ContinuousInsideDE.xml</argument>
  </application-desc>
  <!-- applet-desc 
         name="ContinuousInsideDE Applet"
         main-class="ptolemy.vergil.VergilApplet"
         width="632"
         height="1158">
   </applet-desc-->


</jnlp>
