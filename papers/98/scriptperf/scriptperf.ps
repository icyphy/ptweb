% Font[Monospaced, 0, 10]
378 10 8 SF
(    for \(var i = 0; i  n; i++\)) 180 72 388 DS
() 0 252 388 DS
(        ip[i] = i ;) 114 72 377 DS
() 0 186 377 DS
