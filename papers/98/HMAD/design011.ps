/FmBx { dup 3 index lt {3 1 roll exch} if 
 1 index 4 index lt {4 -1 roll 3 1 roll exch 4 1 roll} if
}FmBD
/FmPD/cleartomark FmLD
/FmPD2/cleartomark FmLD
