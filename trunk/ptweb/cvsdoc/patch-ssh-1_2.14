+    extern void forkexec_setargv0_dir(char *);
+
+    /* Extract the directory from argv[0] */
+    len = strlen(argv[0]);
+    for (i = len; i >= 0; i--) {
+	c = argv[0][i];
+	if (c == '/') {
+	    break;
+	}
+    }
+    i++;
+    if (i == 0) {
+	if (len >= 3 && argv[0][1] == ':') {
+	    i = 2;
+	}
+    }
+
+    if (i > 0) {
+	save = argv[0][i];
+	argv[0][i] = '\0';
+
+	if (getcwd(currdir, MAXPATHLEN+1) == NULL) {
+	    fprintf(stderr, "Unable to get working directory.");
+	    exit(1);
+	}
+	if (chdir(argv[0]) == -1) {
+	    fprintf(stderr, "Unable to cd to %s\n", argv[0]);
+	    exit(1);
+	}
+	if (getcwd(argv0_dir, MAXPATHLEN+1) == NULL) {
+	    fprintf(stderr, "Unable to get working directory.");
+	    exit(1);
+	}
+	if (chdir(currdir) == -1) {
+	    fprintf(stderr, "Unable to cd to %s\n", currdir);
+	    exit(1);
+	}
+	argv[0][i] = save;
+	len = strlen(argv0_dir);
+	argv0_dir[len] = '/';
+	argv0_dir[len+1] = '\0';
+    } else {
+	argv0_dir[0] = '\0';
+    }
+
+    forkexec_setargv0_dir(argv0_dir);
+}
